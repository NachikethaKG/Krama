{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "../../frontend/node_modules/@types"
    ],
    "paths": {
      "@krama/contracts-ts": ["../contracts-ts/src/index.ts"],
      "ajv": ["../../frontend/node_modules/ajv/dist/ajv.d.ts"],
      "ajv/dist/2020.js": ["../../frontend/node_modules/ajv/dist/2020.d.ts"],
      "ajv-formats": ["../../frontend/node_modules/ajv-formats/dist/index.d.ts"],
      "vitest": ["../../frontend/node_modules/vitest/dist/index.d.ts"]
    }
  },
  "include": ["src", "tests"]
}
