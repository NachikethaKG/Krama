# Backend recipes (owner: Vishwas). Run from the repo root as `just backend <recipe>`.

set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

# Install/sync dependencies from uv.lock
install:
    uv sync

# API dev server with auto-reload on :8000
dev:
    uv run uvicorn app.main:app --reload --loop app.dev_loop:factory --port 8000

# Run worker: executes queued runs (needs Redis from `just up` and RUN_EXECUTOR=arq for the API, #95)
worker:
    uv run krama worker

# Narration for video export (#120): the Piper worker's own venv (GPL, docs/adr/0004) + the voice (64 MB)
tts-setup:
    uv sync --project tts-worker --frozen
    uv run --project tts-worker --frozen python -m piper.download_voices --data-dir ../data/tts/voices en_US-ljspeech-medium

# Apply all database migrations (Postgres from `just up`; DATABASE_URL in the repo-root .env)
migrate:
    uv run alembic upgrade head

# New migration from model changes. Review it by hand: autogenerate misses CHECK changes and renames
migration name:
    uv run alembic revision --autogenerate -m "{{name}}"

test *args:
    uv run pytest {{args}}

lint:
    uv run ruff check .
    uv run ruff format --check .

# Auto-fix lint and formatting
fmt:
    uv run ruff check --fix .
    uv run ruff format .

typecheck:
    uv run mypy .

# Everything CI runs
check: lint typecheck test
