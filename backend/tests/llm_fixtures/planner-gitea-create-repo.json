{
  "name": "planner-gitea-create-repo",
  "description": "Real gemini-2.5-flash reply (2026-10-07) to the #35 planner prompt: create demo-repo from the Gitea dashboard.",
  "schema_name": "LLMPlan",
  "prompt_contains": [
    "demo-repo",
    "<page_snapshot"
  ],
  "model": "gemini-2.5-flash",
  "response": {
    "expected_result": "A new repository named 'demo-repo' is created and initialized with a README.",
    "steps": [
      {
        "seq": 1,
        "action": {
          "type": "click"
        },
        "target": {
          "role": "link",
          "name": "New Repository"
        },
        "instruction_text": "Click the 'New Repository' link to go to the repository creation page.",
        "expected_state": {
          "url_matches": "^/repo/create$",
          "visible": [
            {
              "role": "textbox",
              "name": "Repository Name *"
            },
            {
              "role": "checkbox",
              "name": "Initialize Repository (Adds .gitignore, License and README)"
            }
          ]
        },
        "risk": "low"
      },
      {
        "seq": 2,
        "action": {
          "type": "fill",
          "value": "demo-repo"
        },
        "target": {
          "role": "textbox",
          "name": "Repository Name *"
        },
        "instruction_text": "Enter 'demo-repo' as the repository name.",
        "expected_state": {
          "field_values": [
            {
              "role": "textbox",
              "name": "Repository Name *",
              "value": "demo-repo"
            }
          ]
        },
        "risk": "low"
      },
      {
        "seq": 3,
        "action": {
          "type": "click"
        },
        "target": {
          "role": "checkbox",
          "name": "Initialize Repository (Adds .gitignore, License and README)"
        },
        "instruction_text": "Check the 'Initialize Repository' checkbox.",
        "expected_state": {
          "checked": [
            {
              "role": "checkbox",
              "name": "Initialize Repository (Adds .gitignore, License and README)"
            }
          ]
        },
        "risk": "low"
      },
      {
        "seq": 4,
        "action": {
          "type": "click"
        },
        "target": {
          "role": "button",
          "name": "Create Repository"
        },
        "instruction_text": "Click the 'Create Repository' button to create the new repository.",
        "expected_state": {
          "url_matches": "^/demo/demo-repo$",
          "visible": [
            {
              "role": "heading",
              "name": "demo-repo"
            }
          ]
        },
        "risk": "medium"
      }
    ],
    "clarification_question": null
  }
}
