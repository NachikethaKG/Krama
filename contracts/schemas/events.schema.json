{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "RunEvent",
  "$comment": "v1.7. Live-view events sent over SSE on GET /runs/{id}/events. SSE `event:` = type, `id:` = seq. Keep-alives are SSE comment lines, not events.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/RunStartedEvent" },
    { "$ref": "#/$defs/StepDecidedEvent" },
    { "$ref": "#/$defs/StepStartedEvent" },
    { "$ref": "#/$defs/StepActionDoneEvent" },
    { "$ref": "#/$defs/StepVerifiedEvent" },
    { "$ref": "#/$defs/StepFailedEvent" },
    { "$ref": "#/$defs/RunReplanningEvent" },
    { "$ref": "#/$defs/RunPausedEvent" },
    { "$ref": "#/$defs/RunCompletedEvent" },
    { "$ref": "#/$defs/RunFailedEvent" },
    { "$ref": "#/$defs/RunCancelledEvent" },
    { "$ref": "#/$defs/RunResumedEvent" },
    { "$ref": "#/$defs/TakeoverStartedEvent" },
    { "$ref": "#/$defs/TakeoverEndedEvent" }
  ],
  "discriminator": { "propertyName": "type" },
  "$defs": {
    "RunStartedEvent": {
      "title": "RunStartedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "plan_id", "total_steps"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.started" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "plan_id": { "type": "string", "format": "uuid" },
        "total_steps": { "type": "integer", "minimum": 1 }
      }
    },
    "StepDecidedEvent": {
      "title": "StepDecidedEvent",
      "type": "object",
      "description": "Step mode (ADR 0011): the agent looked at the page and chose the next action. Followed by step.started for the same step_seq, unless the policy stops it.",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "thought", "action"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "step.decided" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "outline_seq": { "type": ["integer", "null"], "minimum": 1, "description": "The outline item it works on" },
        "thought": { "type": "string", "description": "One line: what the page shows and why this action. Masked." },
        "action": { "$ref": "common.schema.json#/$defs/Action" },
        "target": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/Target" }, { "type": "null" }]
        }
      }
    },
    "StepStartedEvent": {
      "title": "StepStartedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "instruction_text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "step.started" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "instruction_text": { "type": "string" }
      }
    },
    "StepActionDoneEvent": {
      "title": "StepActionDoneEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "step.action_done" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "screenshot_url": { "type": ["string", "null"] },
        "bbox": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/BoundingBox" }, { "type": "null" }]
        }
      }
    },
    "StepVerifiedEvent": {
      "title": "StepVerifiedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "method", "confidence"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "step.verified" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "method": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/VerificationMethod" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "performed_by": {
          "$ref": "common.schema.json#/$defs/PerformedBy",
          "default": "krama",
          "description": "human: the run's owner did this step in a takeover and Krama only verified it (ADR 0008)."
        }
      }
    },
    "StepFailedEvent": {
      "title": "StepFailedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "expected", "observed"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "step.failed" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "expected": { "$ref": "common.schema.json#/$defs/ExpectedState" },
        "observed": { "$ref": "#/$defs/ObservedSummary" },
        "screenshot_url": { "type": ["string", "null"] }
      }
    },
    "RunReplanningEvent": {
      "title": "RunReplanningEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "reason", "attempt"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.replanning" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "RunPausedEvent": {
      "title": "RunPausedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "reason", "step_seq"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.paused" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/PauseReason" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "message": { "type": "string" },
        "plan_id": {
          "type": "string",
          "format": "uuid",
          "description": "For replan_review: the plan with the proposed steps (GET /plans/{id})"
        },
        "takeover_available": {
          "type": "boolean",
          "default": false,
          "description": "The run's owner may take over the live page now (POST /runs/{id}/takeover, ADR 0008)."
        }
      }
    },
    "RunCompletedEvent": {
      "title": "RunCompletedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "verified_steps", "failed_actions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.completed" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "workflow_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "The workflow the run stored; for a reverify run, the stored workflow it re-verified; for a do_it run, the stored workflow it ran (nothing is stored). Null for a sign_in run."
        },
        "verified_steps": { "type": "integer", "minimum": 0 },
        "failed_actions": { "type": "integer", "minimum": 0 }
      }
    },
    "RunFailedEvent": {
      "title": "RunFailedEvent",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "error"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.failed" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "error": { "$ref": "common.schema.json#/$defs/ApiError" }
      }
    },
    "RunCancelledEvent": {
      "title": "RunCancelledEvent",
      "type": "object",
      "description": "Final event: the run ended as `cancelled`. The stream closes after it.",
      "required": ["type", "run_id", "seq", "ts", "reason"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.cancelled" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/CancelReason" },
        "step_seq": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The step the run was on; null if it was cancelled before the first step"
        }
      }
    },
    "RunResumedEvent": {
      "title": "RunResumedEvent",
      "type": "object",
      "description": "A paused run continues after POST /runs/{id}/confirm with decision allow.",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "decision"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "run.resumed" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "decision": { "const": "allow" }
      }
    },
    "TakeoverStartedEvent": {
      "title": "TakeoverStartedEvent",
      "description": "The run's owner took control of the paused run's page (ADR 0008). The run stays paused.",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "takeover.started" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 }
      }
    },
    "TakeoverEndedEvent": {
      "title": "TakeoverEndedEvent",
      "description": "The takeover ended. handed_back: the owner said what they did (`done`) and Krama checks it; idle: 5 min without input; closed: the screen connection went away; cancelled: the run was cancelled. Except after handed_back, the run stays paused.",
      "type": "object",
      "required": ["type", "run_id", "seq", "ts", "step_seq", "reason"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "takeover.ended" },
        "run_id": { "type": "string", "format": "uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "step_seq": { "type": "integer", "minimum": 1 },
        "reason": { "$ref": "common.schema.json#/$defs/TakeoverEndReason" },
        "done": { "$ref": "common.schema.json#/$defs/HandBackDone" }
      }
    },
    "PauseReason": {
      "title": "PauseReason",
      "description": "Why a run waits for a human. POST /runs/{id}/confirm with allow continues, deny cancels.",
      "enum": [
        "destructive_action",
        "captcha",
        "auth_wall",
        "rate_limited",
        "verification_unclear",
        "replan_review",
        "recovery_exhausted",
        "no_progress",
        "step_budget",
        "sensitive_data",
        "prompt_injection"
      ]
    },
    "CancelReason": {
      "title": "CancelReason",
      "description": "`user`: POST /runs/{id}/cancel. `confirmation_denied`: POST /runs/{id}/confirm with decision deny.",
      "enum": ["user", "confirmation_denied"]
    },
    "ObservedSummary": {
      "title": "ObservedSummary",
      "type": "object",
      "description": "Short version of what the page showed, for the live view.",
      "required": ["url", "title"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "The path, plus ?query when the page has one (#463)" },
        "title": { "type": "string" }
      }
    }
  }
}
