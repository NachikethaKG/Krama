{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step.schema.json",
  "title": "Step",
  "$comment": "v1.0. One executed and verified step of a Verified Workflow (docs/phases/README.md §3.1, docs/database-schema.md).",
  "type": "object",
  "required": [
    "id",
    "seq",
    "action",
    "target",
    "instruction_text",
    "expected_state",
    "observed_state",
    "verification",
    "risk"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "workflow_id": { "type": ["string", "null"], "format": "uuid" },
    "seq": { "type": "integer", "minimum": 1 },
    "action": { "$ref": "common.schema.json#/$defs/Action" },
    "target": { "$ref": "#/$defs/StepTarget" },
    "instruction_text": { "type": "string", "minLength": 1 },
    "before_state": {
      "oneOf": [{ "$ref": "#/$defs/ObservedState" }, { "type": "null" }]
    },
    "expected_state": { "$ref": "common.schema.json#/$defs/ExpectedState" },
    "observed_state": { "$ref": "#/$defs/ObservedState" },
    "verification": { "$ref": "#/$defs/StepVerification" },
    "risk": { "$ref": "common.schema.json#/$defs/Risk" },
    "sensitive": { "type": "boolean", "default": false },
    "screenshot_path": { "type": ["string", "null"] },
    "timing": {
      "oneOf": [{ "$ref": "#/$defs/StepTiming" }, { "type": "null" }]
    },
    "start_ms": { "type": ["integer", "null"], "minimum": 0 },
    "end_ms": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "VerificationResult": {
      "title": "VerificationResult",
      "enum": ["verified", "failed", "skipped"]
    },
    "StepVerification": {
      "title": "StepVerification",
      "type": "object",
      "required": ["result", "method", "confidence"],
      "additionalProperties": false,
      "properties": {
        "result": { "$ref": "#/$defs/VerificationResult" },
        "method": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/VerificationMethod" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "StepTarget": {
      "title": "StepTarget",
      "type": "object",
      "description": "How to locate the element, and its resolved bounding box if observed.",
      "additionalProperties": false,
      "properties": {
        "role": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "selector": { "type": ["string", "null"] },
        "bbox": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/BoundingBox" }, { "type": "null" }]
        }
      }
    },
    "StepTiming": {
      "title": "StepTiming",
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "ObservedState": {
      "title": "ObservedState",
      "type": "object",
      "description": "The page state captured after executing the step.",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "URL path only, e.g. /repo/create" },
        "title": { "type": ["string", "null"] },
        "headings": { "type": "array", "items": { "type": "string" } },
        "aria_excerpt": { "type": ["string", "null"] },
        "screenshot": { "type": ["string", "null"] },
        "screenshot_path": { "type": ["string", "null"] },
        "captured_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
