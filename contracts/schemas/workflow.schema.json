{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Workflow",
  "$comment": "v1.1. The verified workflow, the core object of Krama (docs/phases/README.md §3.1, docs/database-schema.md).",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Workflow format version (e.g. 1.0)."
    },
    "revision": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Number of the workflow version whose steps and recording this is (1 = as first recorded). Not the format `version` above."
    },
    "task_id": { "type": ["string", "null"], "format": "uuid" },
    "run_id": { "type": ["string", "null"], "format": "uuid" },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable title describing the workflow."
    },
    "task": {
      "type": ["string", "null"],
      "description": "Original task prompt or goal."
    },
    "target": {
      "oneOf": [{ "$ref": "#/$defs/WorkflowTarget" }, { "type": "null" }]
    },
    "target_app": {
      "type": ["string", "null"],
      "description": "Application name, e.g. gitea, github."
    },
    "target_url": { "type": ["string", "null"], "format": "uri" },
    "status": { "$ref": "#/$defs/WorkflowStatus" },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Overall verification confidence score."
    },
    "preconditions": {
      "type": ["object", "null"],
      "description": "Required preconditions before running (e.g. {logged_in_as: 'demo'})."
    },
    "viewport": {
      "oneOf": [{ "$ref": "#/$defs/WorkflowViewport" }, { "type": "null" }]
    },
    "recording": {
      "oneOf": [{ "$ref": "#/$defs/WorkflowRecording" }, { "type": "null" }]
    },
    "recording_path": {
      "type": ["string", "null"],
      "description": "Relative artifact path to rrweb recording."
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "step.schema.json" },
      "description": "The ordered sequence of verified steps."
    },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "WorkflowStatus": {
      "title": "WorkflowStatus",
      "enum": ["draft", "approved", "running", "verified", "failed", "outdated"]
    },
    "WorkflowTarget": {
      "title": "WorkflowTarget",
      "type": "object",
      "required": ["app"],
      "additionalProperties": false,
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "base_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "WorkflowViewport": {
      "title": "WorkflowViewport",
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "device_scale_factor": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "WorkflowRecording": {
      "title": "WorkflowRecording",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rrweb": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "event_count": { "type": ["integer", "null"], "minimum": 0 },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "WorkflowSummary": {
      "title": "WorkflowSummary",
      "type": "object",
      "required": ["id", "title", "status", "step_count"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/WorkflowStatus" },
        "target_app": { "type": ["string", "null"] },
        "step_count": { "type": "integer", "minimum": 0 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "created_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "WorkflowPage": {
      "title": "WorkflowPage",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/WorkflowSummary" } },
        "next_cursor": { "type": ["string", "null"] }
      }
    },
    "WorkflowVersionSource": {
      "title": "WorkflowVersionSource",
      "description": "What made the version: the first verified run, a self-heal, a regenerated plan, or a human edit.",
      "enum": ["initial", "heal", "regenerate", "edit"]
    },
    "WorkflowVersionStatus": {
      "title": "WorkflowVersionStatus",
      "description": "current: the one shown. pending_review: waits for the owner to accept it. superseded: an older current one. rejected: the owner turned it down.",
      "enum": ["current", "pending_review", "superseded", "rejected"]
    },
    "WorkflowVersion": {
      "title": "WorkflowVersion",
      "type": "object",
      "required": ["id", "workflow_id", "revision", "source", "status", "step_count", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "workflow_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/WorkflowVersionSource"
        },
        "status": {
          "$ref": "#/$defs/WorkflowVersionStatus"
        },
        "parent_version_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "The version this one was made from; null for the first."
        },
        "run_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "The run that recorded this version."
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "step_count": {
          "type": "integer",
          "minimum": 0
        },
        "change_summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/StepDiff"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the steps differ from the parent version; null for the first."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "WorkflowVersionList": {
      "title": "WorkflowVersionList",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowVersion"
          },
          "description": "Newest first."
        }
      }
    },
    "StepDiff": {
      "title": "StepDiff",
      "type": "object",
      "required": ["from_revision", "to_revision", "steps"],
      "additionalProperties": false,
      "properties": {
        "from_revision": {
          "type": "integer",
          "minimum": 1
        },
        "to_revision": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepChange"
          },
          "description": "Every step of both versions, aligned by meaning, in the new version's order."
        }
      }
    },
    "StepChangeKind": {
      "title": "StepChangeKind",
      "enum": ["same", "changed", "added", "removed"]
    },
    "StepChangeCategory": {
      "title": "StepChangeCategory",
      "description": "behaviour: what the step does or acts on. check: its expected state. wording: only its instruction text (the UI may collapse these). risk: its risk level.",
      "enum": ["behaviour", "check", "wording", "risk"]
    },
    "StepChange": {
      "title": "StepChange",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StepChangeKind"
        },
        "old_seq": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Null for an added step."
        },
        "new_seq": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Null for a removed step."
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/StepChangeCategory"
            },
            {
              "type": "null"
            }
          ],
          "description": "The most important category among the changes; null for a same step."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          },
          "default": []
        },
        "summary": {
          "type": ["string", "null"],
          "description": "Short text for an added or removed step, e.g. 'click button “Confirm”'."
        }
      }
    },
    "FieldChange": {
      "title": "FieldChange",
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Dotted path in the step, e.g. target.name, action.value, expected_state."
        },
        "from": {
          "description": "The old value (any JSON); absent or null if there was none."
        },
        "to": {
          "description": "The new value (any JSON); absent or null if there is none."
        }
      }
    },
    "ValidationStatus": {
      "title": "ValidationStatus",
      "description": "Result of one validation of a stored workflow (docs/research/phase-4-decisions-alignment.md): passed, healed (a new current version), heal_pending (a new version waits for review), outdated, blocked (the environment stopped it; the workflow's status is unchanged), skipped (not replayable).",
      "enum": ["passed", "healed", "heal_pending", "outdated", "blocked", "skipped"]
    }
  }
}
