# Copy to .env (`just setup` does this). Never commit .env.
# Add new variables here in the same PR that introduces them, with a comment.

# --- Infra (infra/docker-compose.yml) ---------------------------------------
# Host port 5433, not 5432, to avoid clashing with a locally installed Postgres
POSTGRES_USER=krama
POSTGRES_PASSWORD=krama-local-only
POSTGRES_DB=krama
POSTGRES_PORT=5433
# 127.0.0.1, not localhost: on Windows + Docker Desktop, localhost tries IPv6 first and the DB driver waits
# ~21 s for it to time out on every new connection.
DATABASE_URL=postgresql+asyncpg://krama:krama-local-only@127.0.0.1:5433/krama
REDIS_PORT=6379
# 127.0.0.1 for the same reason: arq's async Redis client times out on IPv6 localhost (phase-3-vishwas-job-queue.md)
REDIS_URL=redis://127.0.0.1:6379/0

# --- Test target: local Gitea ------------------------------------------------
GITEA_PORT=3001
GITEA_URL=http://localhost:3001
# Local throwaway accounts created by `just seed`. Not real credentials.
GITEA_ADMIN_USER=krama-admin
GITEA_ADMIN_PASSWORD=krama-admin-local-only
GITEA_DEMO_USER=demo
GITEA_DEMO_PASSWORD=demo-local-only

# --- Test target: real GitHub (Phase 3) -------------------------------------
# The GitHub test account and org (docs/research/phase-3-together-github-account-and-benchmarks.md).
# Runs use the account's stored, encrypted browser session (`uv run krama session capture github`), never a password.
GITHUB_URL=https://github.com
GITHUB_TEST_USER=krama-bot-vishwas
GITHUB_TEST_ORG=krama-bench
# Fine-grained token, resource owner = the test org; only the benchmark's setup, grading and cleanup use it.
# Ask the account owner for it. Never commit it.
GITHUB_BENCH_TOKEN=
# Fernet key(s) that encrypt stored browser sessions, newest first, comma-separated. Make one with
# `uv run krama session key`. Each laptop has its own; a new key can't read sessions stored with an old one.
KRAMA_STORAGE_KEY=

# --- Accounts (Phase 3, #94) ------------------------------------------------
# Password (15+ characters) of the seeded demo account demo@krama.dev, set by `just seed-users`. Local only.
KRAMA_DEMO_PASSWORD=
# The benchmark signs in as the demo account unless these name another one.
# KRAMA_BENCH_EMAIL=
# KRAMA_BENCH_PASSWORD=

# --- LLM --------------------------------------------------------------------
# fake | gemini        (fake = recorded fixtures, used by tests and CI)
LLM_PROVIDER=gemini
# Get your own key at https://aistudio.google.com/apikey (one key per person: free-tier limits are per key)
GEMINI_API_KEY=
# Optional: models tried in order (each has its own free-tier quota). Default:
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# --- Backend ----------------------------------------------------------------
API_PORT=8000
ARTIFACTS_DIR=./data/artifacts
MAX_CONCURRENT_RUNS=1
# Recovery budget per run: running time in seconds (pauses not counted), and replans of the remaining steps
RUN_TIMEOUT_SECONDS=600
MAX_REPLANS_PER_RUN=3
# true only for manual login / debugging
BROWSER_HEADED=false

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# mock = serve contracts/fixtures, no backend needed | http = real backend
NEXT_PUBLIC_API_MODE=mock
